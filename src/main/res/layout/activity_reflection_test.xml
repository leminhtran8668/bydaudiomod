<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1E1E1E">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kiểm tra Reflection dữ liệu xe"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_scan_services"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quét dịch vụ BYD"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_test_reflection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kiểm tra Reflection CarDataManager"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#333333"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_reflection_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kết quả sẽ hiển thị ở đây..."
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
