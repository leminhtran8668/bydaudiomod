<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0F"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFE0E0E0"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="#FF9E9E9E"
                android:textSize="13sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Tab Bar - 4 tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/tab_inactive"
            android:padding="3dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tab_inside"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tab_inside"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@drawable/tab_active" />

            <TextView
                android:id="@+id/tab_outside"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tab_outside"
                android:textColor="#FF9E9E9E"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/tab_feedback"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tab_feedback"
                android:textColor="#FF9E9E9E"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/tab_about"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tab_about"
                android:textColor="#FF9E9E9E"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Master Toggle (for door sounds) -->
        <LinearLayout
            android:id="@+id/master_toggle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background_accent"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enabled"
                    android:textColor="#FFE0E0E0"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enabled_subtitle"
                    android:textColor="#FF9E9E9E"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:track="@drawable/switch_track"
                android:thumb="@drawable/switch_thumb" />
        </LinearLayout>

        <!-- ==================== INSIDE SPEAKER CONTENT ==================== -->
        <LinearLayout
            android:id="@+id/content_inside"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <include layout="@layout/card_inside_event"
                android:id="@+id/card_inside_door_open" />
            <include layout="@layout/card_inside_event"
                android:id="@+id/card_inside_door_close" />
            <include layout="@layout/card_inside_event"
                android:id="@+id/card_inside_lock" />
            <include layout="@layout/card_inside_event"
                android:id="@+id/card_inside_unlock" />
        </LinearLayout>

        <!-- ==================== OUTSIDE SPEAKER CONTENT ==================== -->
        <LinearLayout
            android:id="@+id/content_outside"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/card_outside_event"
                android:id="@+id/card_outside_door_open" />
            <include layout="@layout/card_outside_event"
                android:id="@+id/card_outside_door_close" />
            <include layout="@layout/card_outside_event"
                android:id="@+id/card_outside_lock" />
            <include layout="@layout/card_outside_event"
                android:id="@+id/card_outside_unlock" />
        </LinearLayout>

        <!-- ==================== FEEDBACK CONTENT ==================== -->
        <LinearLayout
            android:id="@+id/content_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_title"
                android:textColor="#FF00D4AA"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_subtitle"
                android:textColor="#FF9E9E9E"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <CheckBox
                    android:id="@+id/cb_gear_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_gear"
                    android:textColor="#FFE0E0E0"
                    android:checked="true"
                    android:padding="8dp" />

                <CheckBox
                    android:id="@+id/cb_acc_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_acc"
                    android:textColor="#FFE0E0E0"
                    android:checked="true"
                    android:padding="8dp" />

                <CheckBox
                    android:id="@+id/cb_bsd_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_bsd"
                    android:textColor="#FFE0E0E0"
                    android:checked="true"
                    android:padding="8dp" />

                <CheckBox
                    android:id="@+id/cb_radar_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_radar"
                    android:textColor="#FFE0E0E0"
                    android:checked="true"
                    android:padding="8dp" />

                <CheckBox
                    android:id="@+id/cb_energy_recycle_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_energy_recycle"
                    android:textColor="#FFE0E0E0"
                    android:checked="true"
                    android:padding="8dp" />

                <CheckBox
                    android:id="@+id/cb_energy_road_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_energy_road"
                    android:textColor="#FFE0E0E0"
                    android:checked="true"
                    android:padding="8dp" />

                <CheckBox
                    android:id="@+id/cb_operation_mode_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_operation_mode"
                    android:textColor="#FFE0E0E0"
                    android:checked="true"
                    android:padding="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_save_feedback"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/save_feedback"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/btn_primary"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- ==================== ABOUT / AUTHOR CONTENT ==================== -->
        <LinearLayout
            android:id="@+id/content_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background_accent"
                android:padding="24dp"
                android:gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/author_title"
                    android:textColor="#FF00D4AA"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/author_name"
                    android:textColor="#FFE0E0E0"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/author_desc"
                    android:textColor="#FF9E9E9E"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/author_thanks"
                    android:textColor="#FF6E6E6E"
                    android:textSize="11sp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dev_tools"
                android:textColor="#FF00D4AA"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_adas"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_adas"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/btn_primary"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_reflection"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_reflection"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/btn_primary" />
        </LinearLayout>

        <!-- Status (always visible) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/service_status"
                android:textColor="#FF00D4AA"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/status_dot_stopped"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/text_service_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_stopped"
                    android:textColor="#FF9E9E9E"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_last_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF9E9E9E"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
